{
  "name": "glosswatch",
  "description": "Local subtitle tools for language learners (early development).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youssof20/glosswatch.git"
  },
  "author": "youssof20",
  "keywords": ["browser-extension", "subtitles", "language-learning", "chrome", "firefox"],
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "smoke": "node scripts/smoke-phase0.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
