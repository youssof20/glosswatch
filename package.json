{
  "name": "glosswatch",
  "description": "Clickable subtitles for any video. Local, free, no account, no tracking.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "smoke": "node scripts/smoke-phase0.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
